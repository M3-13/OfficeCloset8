{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": ["${python}", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "${PORT}"],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "DATABASE_URL": {
          "dev": "sqlite:///./officecloset.db"
        },
        "UPLOAD_DIR": {
          "dev": "./upload"
        }
      }
    },
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "node",
      "kind": "cli",
      "install": [
        ["npm", "ci"]
      ],
      "start": ["npm", "run", "build"]
    }
  ]
}
